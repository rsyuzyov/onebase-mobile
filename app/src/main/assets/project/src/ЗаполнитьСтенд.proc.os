Процедура Выполнить() Экспорт
Ном = Справочники.Номенклатура.Создать();
Ном.Наименование = "Гвозди 100мм";
СсылкаНом = Ном.Записать();

Пост = Справочники.Поставщик.Создать();
Пост.Наименование = "ООО Метизы";
СсылкаПост = Пост.Записать();

Скл = Справочники.Склад.Создать();
Скл.Наименование = "Основной";
СсылкаСкл = Скл.Записать();

Док = Документы.Поступление.Создать();
Док.Дата = ТекущаяДата();
Док.Поставщик = СсылкаПост;
Док.Склад = СсылкаСкл;
Стр = Док.Товары.Добавить();
Стр.Номенклатура = СсылкаНом;
Стр.Количество = 10;
Стр.Цена = 5;
Стр.Сумма = 50;
Док.Сумма = 50;
СсылкаДок = Док.Провести();

Сообщить("проведено: " + СсылкаДок);
КонецПроцедуры
